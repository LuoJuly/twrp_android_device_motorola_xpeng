#
# USB path aligned with LineageOS device/motorola/xpeng init.qcom.recovery.rc:
#   - on init: ONLY setprop sys.usb.configfs 1
#   - gadget nodes created by stock recovery init.rc on fs && configfs=1
#   - do NOT early-mount/create /config/usb_gadget (breaks stock fs action)
#
# TWRP difference vs Lineage: Lineage has ro.debuggable=0 and enables ADB from
# the recovery UI; we run enable_adb (none→adb) after boot for default ADB.
#
# FBE decrypt: qcom twrp-common prepdecrypt + keymaster 4.1 / gatekeeper / qseecomd
import /init.recovery.qcom_decrypt.rc

on init
    start overrideprops
    write /sys/class/backlight/panel0-backlight/brightness 200
    # Seed temp/battery files before recovery GUI evaluates header widgets.
    # Battery must be 1..100: legacy monitor uses "-1%" when unread, and the
    # theme hides tw_battery unless 0 < pct < 101.
    mkdir /tmp 0777
    write /tmp/twrp_cpu_temp 0
    mkdir /tmp/twrp_battery 0755
    # Temporary seed only (1%); init_thermal replaces with FG SOC after ADSP
    write /tmp/twrp_battery/capacity 1
    write /tmp/twrp_battery/status Discharging
    # LineageOS: enable configfs USB; leave gadget creation to init.rc on fs
    setprop sys.usb.configfs 1
    # Decrypt bring-up logging. Do NOT sync live OS/vendor security patches —
    # TWRP keeps 2099-12-31 so Keymaster upgrades wrapped FBE keys. setpatch
    # true was overwriting that and is unsafe for wrappedkey_v0 metadata decrypt.
    setprop prepdecrypt.loglevel 2
    setprop prepdecrypt.setpatch false

# Dual-role (otg): peripheral for ADB when PC-attached, host when OTG adapter
# is used. Forced "peripheral" (Lineage default) blocks USB host / U-disk mount.
on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode otg

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    # qseecomd runs as system — allow RPMB/ION (metadata FBE key unwrap)
    wait /dev/0:0:0:49476 1
    chmod 0660 /dev/0:0:0:49476 /dev/0:0:0:49456 /dev/0:0:0:49488 /dev/qseecom /dev/ion
    chown system system /dev/0:0:0:49476 /dev/0:0:0:49456 /dev/0:0:0:49488 /dev/qseecom /dev/ion
    # Bring up TEE/keymaster before recovery Decrypt_Data (needs libion in ramdisk)
    start ensure_decrypt

    # LineageOS: ADSP/PMIC firmware lives on modem, not vendor
    mkdir /firmware
    mount ext4 /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro

# Firmware mounted → load ADSP modules + boot ADSP + publish battery/temp
on property:dev.mnt.blk.firmware=*
    start init_thermal

on boot
    start set_permissive
    # Fallback if firmware mount property did not fire
    start init_thermal
    # Async touch module load (does not block USB / TWRP UI)
    start runatboot
    # Default ADB once only. A second none→adb after runatboot soft-disconnects
    # the already-enumerated gadget; this dwc3 often will not re-enum until
    # the cable is replugged (host loses adb for ~minute until replug).
    start enable_adb
    start ensure_decrypt

service init_thermal /system/bin/init_thermal.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service runatboot /system/bin/runatboot.sh
    oneshot
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service enable_adb /system/bin/enable_adb.sh
    oneshot
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service overrideprops /system/bin/overrideprops.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service set_permissive /system/bin/set_permissive.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service ensure_decrypt /system/bin/ensure_decrypt.sh
    oneshot
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# Built into recovery as /system/bin/... (RECOVERY_BINARY_SOURCE_FILES strips vendor/hw).
# Start only after servicemanager — AServiceManager_addService CHECK-aborts without VINTF.
# oneshot: if it still aborts, do NOT crash-loop (that froze the TWRP UI).
service vendor.qti.vibrator /system/bin/start_vibrator.sh
    user root
    group root input
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:init.svc.servicemanager=running
    start vendor.qti.vibrator
