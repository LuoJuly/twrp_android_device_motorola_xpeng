<!-- Enable HIDL hwservicemanager in recovery.
     Without android.hidl.manager in the framework VINTF, A16 hwservicemanager
     sets hwservicemanager.disabled=true and sleeps — Keymaster 4.1 / Gatekeeper
     cannot register → metadata FBE decrypt fails. -->
<manifest version="1.0" type="framework">
    <hal max-level="8">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal max-level="8">
        <name>android.hidl.token</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ITokenManager</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
