# xpeng: override TWRP keystore2.rc
# Stock TWRP starts keystore2 on late-init before qseecomd/keymaster are up.
# keystore2 then dies (SIGSEGV in km_compat when Keymaster HAL is missing) and
# recovery hangs forever in AServiceManager_waitForService.
#
# Start only after ensure_decrypt sets keystore.ready=1.
# Declare AIDL interface so servicemanager lazy-start can find the service.

on early-fs
    mkdir /tmp/misc 0755
    mkdir /tmp/misc/keystore 0700

on property:keystore.ready=1
    start keystore2

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    disabled
    oneshot
    interface aidl android.system.keystore2.IKeystoreService/default
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
