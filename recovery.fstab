# mount point / device layout
# Logical partitions (v2 fstab like bangkk-twrp): list ext4 + erofs so TWRP
# Save_FS_Flags merges both; Check_FS_Type picks the real FS at mount.
# Prefer ext4 first (current stock xpeng). erofs covers LOS / newer images.
# fs_mgr "ro": stock ext4 uses SHARED_BLOCKS (0x4000) — RDWR → Invalid argument.
# system_root lines mirror bangkk: same /system mount; TWRP remaps to /system_root
# and Get_Bare_Partition_Name() still resolves the super volume as "system".
system       /system       ext4    ro      wait,slotselect,logical,display="System",backup=1
system       /system       erofs   ro      wait,slotselect,logical,display="System",backup=1
system_root  /system       ext4    ro      wait,slotselect,logical,display="System",backup=1
system_root  /system       erofs   ro      wait,slotselect,logical,display="System",backup=1
system_ext   /system_ext   ext4    ro      wait,slotselect,logical,display="System_ext",backup=1
system_ext   /system_ext   erofs   ro      wait,slotselect,logical,display="System_ext",backup=1
product      /product      ext4    ro      wait,slotselect,logical,display="Product",backup=1
product      /product      erofs   ro      wait,slotselect,logical,display="Product",backup=1
vendor       /vendor       ext4    ro      wait,slotselect,logical,display="Vendor",backup=1
vendor       /vendor       erofs   ro      wait,slotselect,logical,display="Vendor",backup=1
/metadata       ext4     /dev/block/bootdevice/by-name/metadata     flags=display="Metadata";fsflags="fileencryption=off"
/data           f2fs     /dev/block/bootdevice/by-name/userdata     flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0:metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption;display="Data"
/persist        ext4     /dev/block/bootdevice/by-name/persist      flags=display="Persist";backup=1
/prodpersist    ext4     /dev/block/bootdevice/by-name/prodpersist  flags=display="ProdPersist"
/firmware       ext4     /dev/block/bootdevice/by-name/modem        flags=display="Firmware";slotselect;backup=1
/dsp            ext4     /dev/block/bootdevice/by-name/dsp          flags=display="DSP";slotselect
/bt_firmware    ext4     /dev/block/bootdevice/by-name/bluetooth    flags=display="BT Firmware";slotselect
# Removable storage — Android v2 lines MUST start with /devices/ so TWRP sets
# Sysfs_Entry and matches block uevents (v1 /mount /devices/... never hotplugs).
# Use exact a600000.ssusb path: prefix matching before the first '*' would otherwise
# match all of /devices/platform/soc/ (including UFS). FS=auto → FAT32 + exFAT.
/devices/platform/soc/8804000.sdhci/mmc_host*                      /external_sd  auto  defaults  display="MicroSD",storage,wipeingui,removable
/devices/platform/soc/1da4000.ufshc_card/host*                      /external_sd  auto  defaults  display="MicroSD",storage,wipeingui,removable
/devices/platform/soc/a600000.ssusb/a600000.dwc3/xhci-hcd.*.auto*   /usb-otg      auto  defaults  display="USB-OTG",storage,wipeingui,removable
/boot           emmc     /dev/block/bootdevice/by-name/boot         flags=display="Boot";backup=1;flashimg=1;slotselect
/misc           emmc     /dev/block/bootdevice/by-name/misc         flags=display="Misc";backup=1;flashimg=1
