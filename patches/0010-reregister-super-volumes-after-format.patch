+bool TWPartitionManager::Reregister_Super_Volumes() {
+	if (!Get_Super_Status())
+		return false;
+
+	Setup_Super_Devices();
+
+	std::string fstab_filename = "/etc/twrp.fstab";
+	if (!TWFunc::Path_Exists(fstab_filename))
+		fstab_filename = "/etc/recovery.fstab";
+	if (!TWFunc::Path_Exists(fstab_filename)) {
+		LOGERR("Reregister_Super_Volumes: no fstab found\n");
+		return false;
+	}
+
+	FILE *fstabFile = fopen(fstab_filename.c_str(), "rt");
+	if (!fstabFile) {
+		LOGERR("Reregister_Super_Volumes: unable to open '%s'\n", fstab_filename.c_str());
+		return false;
+	}
+
+	LOGINFO("Re-registering super volumes from %s\n", fstab_filename.c_str());
+	char fstab_line[MAX_FSTAB_LINE_LENGTH];
+	int added = 0;
+
+	while (fgets(fstab_line, sizeof(fstab_line), fstabFile) != NULL) {
+		if (fstab_line[0] == '#' || strstr(fstab_line, "swap"))
+			continue;
+
+		size_t line_size = strlen(fstab_line);
+		if (line_size == 0)
+			continue;
+		if (fstab_line[line_size - 1] != '\n')
+			fstab_line[line_size] = '\n';
+
+		TWPartition* partition = new TWPartition();
+		if (!partition->Process_Fstab_Line(fstab_line, false, NULL) || !partition->Is_Super) {
+			delete partition;
+			memset(fstab_line, 0, sizeof(fstab_line));
+			continue;
+		}
+
+		if (Find_Partition_By_Path(partition->Get_Mount_Point()) != NULL) {
+			LOGINFO("Super volume %s already registered\n", partition->Get_Mount_Point().c_str());
+			delete partition;
+			memset(fstab_line, 0, sizeof(fstab_line));
+			continue;
+		}
+
+		std::string bare = Get_Bare_Partition_Name(partition->Get_Mount_Point());
+		std::string mapper = "/dev/block/mapper/" + bare;
+		if (DataManager::GetStrValue("tw_has_boot_slots") == "1")
+			mapper += Get_Active_Slot_Suffix();
+		bool present = false;
+		for (int i = 0; i < 50 && !present; ++i) {
+			if (access(mapper.c_str(), F_OK) == 0)
+				present = true;
+			else
+				usleep(100000);
+		}
+		if (!present) {
+			LOGERR("Skip re-register %s: mapper %s missing\n",
+			       partition->Get_Mount_Point().c_str(), mapper.c_str());
+			delete partition;
+			memset(fstab_line, 0, sizeof(fstab_line));
+			continue;
+		}
+
+		if (!Prepare_Super_Volume(partition)) {
+			LOGERR("Prepare_Super_Volume failed for %s\n", partition->Get_Mount_Point().c_str());
+			delete partition;
+			memset(fstab_line, 0, sizeof(fstab_line));
+			continue;
+		}
+
+		Add_Partition(partition);
+		Output_Partition(partition);
+		added++;
+		memset(fstab_line, 0, sizeof(fstab_line));
+	}
+	fclose(fstabFile);
+
+	if (added > 0) {
+		Translate_Partition_Display_Names();
+		Update_System_Details();
+	}
+	LOGINFO("Re-registered %d super volume(s)\n", added);
+	return added > 0;
+}
