diff --git a/openaes/src/isaac/rand.h b/openaes/src/isaac/rand.h
--- a/openaes/src/isaac/rand.h
+++ b/openaes/src/isaac/rand.h
@@ -36,17 +36,18 @@
  If (flag==TRUE), then use the contents of randrsl[0..RANDSIZ-1] as the seed.
 ------------------------------------------------------------------------------
 */
-void randinit(/*_ randctx *r, word flag _*/);
+void randinit(randctx *r, word flag);
 
-void isaac(/*_ randctx *r _*/);
+void isaac(randctx *r);
 
 
 /*
 ------------------------------------------------------------------------------
- Call rand(/o_ randctx *r _o/) to retrieve a single 32-bit random value
+ Call isaac_rand(r) to retrieve a single 32-bit random value.
+ (Not named rand(): C23/clang treats libc rand as taking no arguments.)
 ------------------------------------------------------------------------------
 */
-#define rand(r) \
+#define isaac_rand(r) \
    (!(r)->randcnt-- ? \
      (isaac(r), (r)->randcnt=RANDSIZ-1, (r)->randrsl[(r)->randcnt]) : \
      (r)->randrsl[(r)->randcnt])
