diff --git a/bootloader_message/bootloader_message.cpp b/bootloader_message/bootloader_message.cpp
--- a/bootloader_message/bootloader_message.cpp
+++ b/bootloader_message/bootloader_message.cpp
@@ -19,6 +19,7 @@
 #include <errno.h>
 #include <fcntl.h>
 #include <string.h>
+#include <unistd.h>
 
 #include <optional>
 #include <string>
@@ -37,6 +38,7 @@
 
 using android::fs_mgr::Fstab;
 using android::fs_mgr::ReadDefaultFstab;
+using android::fs_mgr::ReadFstabFromFile;
 
 static std::optional<std::string> g_misc_device_for_test;
 
@@ -45,20 +47,39 @@ void SetMiscBlockDeviceForTest(std::string_view misc_device) {
   g_misc_device_for_test = misc_device;
 }
 
+static std::string misc_from_fstab(const Fstab& fstab) {
+  for (const auto& entry : fstab) {
+    if (entry.mount_point == "/misc") {
+      return entry.blk_device;
+    }
+  }
+  return "";
+}
+
 std::string get_misc_blk_device(std::string* err) {
   if (g_misc_device_for_test.has_value() && !g_misc_device_for_test->empty()) {
     return *g_misc_device_for_test;
   }
   Fstab fstab;
-  if (!ReadDefaultFstab(&fstab)) {
-    *err = "failed to read default fstab";
-    return "";
+  // In TWRP, /etc/recovery.fstab is TWRP format and libfs_mgr cannot parse it,
+  // so ReadDefaultFstab() fails. Fall back to Android-format fstab copies and
+  // common by-name paths so BootControl can initialize (needed by FBE decrypt
+  // via cp_needsCheckpoint → IBootControl::getService()).
+  if (ReadDefaultFstab(&fstab)) {
+    std::string misc = misc_from_fstab(fstab);
+    if (!misc.empty()) return misc;
   }
-  for (const auto& entry : fstab) {
-    if (entry.mount_point == "/misc") {
-      return entry.blk_device;
+  for (const char* path : {"/etc/additional.fstab", "/first_stage_ramdisk/fstab.qcom",
+                           "/first_stage_ramdisk/fstab.default"}) {
+    fstab.clear();
+    if (ReadFstabFromFile(path, &fstab)) {
+      std::string misc = misc_from_fstab(fstab);
+      if (!misc.empty()) return misc;
     }
   }
+  for (const char* path : {"/dev/block/by-name/misc", "/dev/block/bootdevice/by-name/misc"}) {
+    if (access(path, F_OK) == 0) return path;
+  }
 
   *err = "failed to find /misc partition";
   return "";
