diff --git a/Android.mk b/Android.mk
--- a/Android.mk
+++ b/Android.mk
@@ -411,6 +411,10 @@ ifeq ($(TARGET_RECOVERY_QCOM_RTC_FIX),)
 else ifeq ($(TARGET_RECOVERY_QCOM_RTC_FIX),true)
     LOCAL_CFLAGS += -DQCOM_RTC_FIX
 endif
+# Optional device-tree override for default POSIX TZ (e.g. CST-8 for UTC+8)
+ifneq ($(TW_DEFAULT_TIMEZONE),)
+    LOCAL_CFLAGS += -DTW_DEFAULT_TIMEZONE_STR=\"$(TW_DEFAULT_TIMEZONE)\"
+endif
 ifneq ($(TW_NO_LEGACY_PROPS),)
 	LOCAL_CFLAGS += -DTW_NO_LEGACY_PROPS
 endif
