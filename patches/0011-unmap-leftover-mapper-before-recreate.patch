+// First-stage init maps every LP with extents, including the inactive slot
+// (e.g. system_b). Unmap_Super_Devices only destroys active-slot volumes TWRP
+// registered, so leftovers remain. CreateLogicalPartitions then hits EEXIST
+// on the leftover and aborts before vendor_a / system_ext_a are created.
+void TWPartitionManager::Unmap_Leftover_Mapper_Devices() {
+	std::string superPart = Get_Super_Partition();
+	auto metadata = android::fs_mgr::ReadCurrentMetadata(superPart);
+	if (metadata) {
+		for (const auto& partition : metadata->partitions) {
+			std::string name = android::fs_mgr::GetPartitionName(partition);
+			std::string mapper = "/dev/block/mapper/" + name;
+			if (access(mapper.c_str(), F_OK) != 0)
+				continue;
+			LOGINFO("removing leftover mapper: %s\n", name.c_str());
+			if (!DestroyLogicalPartition(name))
+				LOGERR("Failed to unmap leftover mapper %s\n", name.c_str());
+			std::string cow = name + "-cow";
+			if (access(("/dev/block/mapper/" + cow).c_str(), F_OK) == 0) {
+				LOGINFO("removing leftover cow mapper: %s\n", cow.c_str());
+				DestroyLogicalPartition(cow);
+			}
+		}
+		return;
+	}
+
+	LOGERR("Unable to read super metadata; scanning /dev/block/mapper\n");
+	DIR* d = opendir("/dev/block/mapper");
+	if (!d)
+		return;
+	std::vector<std::string> names;
+	struct dirent* de;
+	while ((de = readdir(d)) != nullptr) {
+		if (de->d_name[0] == '.')
+			continue;
+		if (strcmp(de->d_name, "by-uuid") == 0 || strcmp(de->d_name, "userdata") == 0)
+			continue;
+		names.emplace_back(de->d_name);
+	}
+	closedir(d);
+	for (const auto& name : names) {
+		LOGINFO("removing leftover mapper: %s\n", name.c_str());
+		if (!DestroyLogicalPartition(name))
+			LOGERR("Failed to unmap leftover mapper %s\n", name.c_str());
+	}
+}
 
 bool TWPartitionManager::Reregister_Super_Volumes() {
 	if (!Get_Super_Status())
 		return false;
 
+	Unmap_Leftover_Mapper_Devices();
 	Setup_Super_Devices();
 
